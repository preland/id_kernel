// One character from the keyboard, or -1. Releases and modifiers change state
// and produce nothing; everything else is a table lookup.
kb_poll() {
  int sc = kb_scan();
  int ch = 0 - 1;
  ch = kb_step(sc);
} return int ch;

kb_step(int sc) {
  int ch = 0 - 1;
  if(sc >= 0x80) {
    kb_up(sc - 0x80);
  } else if(sc >= 0) {
    ch = kb_down(sc);
  }
} return int ch;
given boot_in (16):(113)
given boot_in (0x90):(-1) then calls kb_up:(0x10)

kb_up(int sc) {
  if(kb_shift(sc) == 1) {
    lset((import kb_st), 0, 0);
  }
} return void;
given boot_in (0x2a):() then calls kb_shift:(0x2a)
given boot_in (0x10):() then calls kb_shift:(0x10)
