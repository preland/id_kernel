// The PCI lookup that finds where the adapter mapped its bar, cut out here
// because fb_start already spent its own budget setting the mode.
fb_start_note(word w, word h) {
  word pci_find_vga_v = pci_find_vga();
  word pci_bar0_v = pci_bar0(pci_find_vga_v);
  fb_note(pci_bar0_v, w, h);
} return void;

// The pixel at the origin of the test framebuffer fb_test_setup builds --
// zeroed by that setup, so a case can tell "still zero" from "fb_px wrote
// here" without knowing alloc's address.
fb_peek0() {
  word ret_w = peek32(fb_base());
} return word ret_w;
given fb_test_setup ():(0)
