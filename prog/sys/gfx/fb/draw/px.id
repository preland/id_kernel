// A framebuffer the tests can safely draw into: real memory from alloc()
// rather than the hardware VBE never answers in a hosted case, sized tall
// enough (20 rows) that con_scroll's 16-row copy has somewhere to land.
fb_test_setup() {
  boot_gfx();
  word base = alloc(4096);
  fb_note(base, 8, 20);
} return void;
