// One character. A newline moves to the next line and everything else draws
// and advances; a character that would run off the right edge wraps first,
// because a console that clips loses the end of every long line.
con_ch(int ch) {
  if(ch == 10) {
    con_nl();
  } else {
    con_draw(ch);
  }
} return void;
given boot_gfx (10):() then calls con_nl:[1]
given boot_gfx (65):() then calls con_draw:(65)

con_draw(int ch) {
  word con_at_v = con_at(0);
  word con_at_v2 = con_at(1);
  con_draw_put(ch, con_at_v, con_at_v2);
} return void;
given boot_gfx (65):() then calls con_draw_put:(65, 0, 0)
given boot_gfx given con_nl_row (66):() then calls con_draw_put:(66, 0, 1)

con_wrap() {
  if(con_at(0) >= 80) {
    con_nl();
  }
} return void;
given boot_gfx ():() then calls con_nl:[0]
given con_wrap_test_setup ():() then calls con_nl:[1]
