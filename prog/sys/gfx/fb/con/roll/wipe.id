
con_wipe(word y) {
  word x = 0;
  while(x < fb_w()) {
    fb_px(x, y, 0x00101018);
    x = x + 1;
  }
} return void;
given boot_gfx (5):() then calls fb_px:[0]
given fb_test_setup (5):() then calls fb_px:[8]

// The whole screen, at boot. A console that starts on whatever the firmware
// left behind looks broken even when it is not.
con_blank() {
  word y = 0;
  while(y < fb_h()) {
    con_wipe(y);
    y = y + 1;
  }
} return void;
given boot_gfx ():() then calls con_wipe:[0]
given fb_test_setup ():() then calls con_wipe:[20]
