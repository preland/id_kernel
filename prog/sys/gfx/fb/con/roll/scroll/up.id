// Scrolling, as a copy of the framebuffer up by one line of text and a clear
// of the row that is left behind.
//
// Copying pixels rather than characters is what lets the console keep no
// screen buffer at all: the picture is the only record of what was written,
// and moving it is moving the text.
con_scroll() {
  word y = 0;
  while(y + 16 < fb_h()) {
    con_copy(y);
    y = y + 1;
  }
  con_scroll_tail();
} return void;
given boot_gfx ():() then calls con_copy:[0] then calls con_scroll_tail:[1]
given fb_test_setup ():() then calls con_copy:[4] then calls con_scroll_tail:[1]

con_copy(word y) {
  word x = 0;
  while(x < fb_w()) {
    con_copy_px(x, y);
    x = x + 1;
  }
} return void;
given boot_gfx (0):() then calls con_copy_px:[0]
given fb_test_setup (0):() then calls con_copy_px:[8]

con_clear(word y) {
  word dy = 0;
  while(dy < 16) {
    con_wipe(y + dy);
    dy = dy + 1;
  }
} return void;
given boot_gfx (0):() then calls con_wipe:(0) then calls con_wipe:(15)
given boot_gfx (100):() then calls con_wipe:(100) then calls con_wipe:(115)
