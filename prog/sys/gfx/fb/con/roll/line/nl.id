
con_nl() {
  wset((import con_st), 0, 0);
  con_nl_row();
} return void;
given boot_gfx ():() then calls con_nl_row:[1]
given con_wrap_test_setup ():() then calls con_nl_row:[1]

// Past the last row, the picture moves up by one line and the bottom is
// cleared. The cursor stays on the last row, which is what makes the console
// scroll rather than run off the screen.
con_roll() {
  if(con_at(1) >= 30) {
    wset((import con_st), 1, 29);
    con_scroll();
  }
} return void;
given boot_gfx ():() then calls con_scroll:[0]
given con_roll_test_setup ():() then calls con_scroll:[1]

con_str(string s) {
  int i = 0;
  while(i < len(s)) {
    int charat_v = charat(s, i);
    con_ch(charat_v);
    i = i + 1;
  }
} return void;
given boot_gfx ("A"):() then calls con_ch:(65)
given boot_gfx (""):() then calls con_ch:[0]
