// A hexadecimal digit. Lowercase only, because the generator only writes
// lowercase and accepting more would be accepting input this never sees.
font_nib(int ch) {
  int n = ch - 48;
  if(ch >= 97) {
    n = ch - 87;
  }
} return int n;
(57):(9)
(97):(10)

// One row of a glyph: eight pixels, most significant bit leftmost.
font_row(int ch, int ln) {
  int ret_i = font_at(ch - 32, ln);
} return int ret_i;
given boot_gfx (32, 0):(0)
given boot_gfx (33, 2):(0x18)

font_at(int g, int ln) {
  int n = 0;
  if(g >= 0 && g < 95) {
    n = (import font_px)[g * 16 + ln];
  }
} return int n;
given boot_gfx (1, 2):(0x18)
given boot_gfx (95, 0):(0)
given boot_gfx (24, 5):(0xc6)
given boot_gfx (48, 5):(0x66)
given boot_gfx (72, 5):(0x6c)
