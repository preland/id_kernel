// The font, decoded once.
//
// It arrives as hexadecimal text, split into four conf.id constants because
// the lexer builds a string literal by concatenation, which is quadratic
// (docs/TODO.md item 10), and becomes a byte per row in an int[]: ninety-five
// glyphs of sixteen rows each, indexed by code point minus thirty-two.
// Anything outside that range draws blank, because a console that faults on
// an unexpected byte is worse than one that leaves a gap.

font_init() {
  export int[] font_px = [];
  string font_rom_v = (import font_rom0) + (import font_rom1) + (import font_rom2) + (import font_rom3);
  font_load(font_rom_v, 0);
} return int 0;
():(0)
():(0) then calls font_load:[1]

font_load(string s, int i) {
  while(i < len(s)) {
    int font_byte_v = font_byte(s, i);
    push((import font_px), font_byte_v);
    i = i + 2;
  }
} return void;
given boot_gfx ("4142", 0):() then calls font_byte:[2]
given boot_gfx ("", 0):() then calls font_byte:[0]

font_byte(string s, int i) {
  int charat_v = charat(s, i);
  int charat_v2 = charat(s, i + 1);
  int ret_i = font_nib(charat_v) * 16 + font_nib(charat_v2);
} return int ret_i;
("41", 0):(65)
("ff", 0):(255)
