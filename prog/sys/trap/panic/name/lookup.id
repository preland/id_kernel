trap_name(word vec) {
  string trap_names_v = (import trap_names);
  int at = trap_skip(trap_names_v, 0, vec);
  string ret_s = trap_name_cut(trap_names_v, at);
} return string ret_s;

trap_skip(string s, int at, word vec) {
  int i = 0;
  while(i < vec) {
    at = bar_at(s, at) + 1;
    i = i + 1;
  }
} return int at;
