// The unsigned reading, split across two functions only for the action
// limit -- `ult_v` is read last because it is what tells apart the signed and
// unsigned readings of the same all-ones dividend, and the other two are
// already named by the time it matters.
show_udiv() {
  word udiv_v = udiv(0xffffffffffffffff, 3);
  word umod_v = umod(0xffffffffffffffff, 3);
  show_udiv2(udiv_v, umod_v);
} return void;
():() then prints:("udiv: 6148914691236517205 umod=0 ult=0\n")
():() then eprints:("")

show_udiv2(word udiv_v, word umod_v) {
  word ult_v = ult(0 - 1, 3);
  print("udiv: " + udiv_v + " umod=" + umod_v + " ult=" + ult_v);
} return void;
(6148914691236517205, 0):() then prints:("udiv: 6148914691236517205 umod=0 ult=0\n")
(5, 2):() then prints:("udiv: 5 umod=2 ult=0\n")
