// The third comparison is against two empty strings, which never depends on
// `s` -- it is read only once the other two are already named, so it stays
// beside the print rather than beside the calls that do depend on `s`.
show_str2_cmp(string s) {
  string eqs_v = eqs(s, "n=42");
  string eqs_v2 = eqs(s, "n=43");
  show_str2_cmp2(eqs_v, eqs_v2);
} return void;
("n=42"):() then prints:("cmp: 101\n")
("n=43"):() then prints:("cmp: 011\n")

show_str2_cmp2(string eqs_v, string eqs_v2) {
  string eqs_v3 = eqs("", "");
  print("cmp: " + eqs_v + eqs_v2 + eqs_v3);
} return void;
("1", "0"):() then prints:("cmp: 101\n")
("0", "0"):() then prints:("cmp: 001\n")

eqs(string s, string t) {
  string r = "0";
  if(s == t) {
    r = "1";
  }
} return string r;
("a", "a"):("1")
("a", "b"):("0")
