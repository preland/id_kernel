// A list, built by pushing and read back by index.
//
// Six elements rather than three, because a fresh list has room for four: the
// fifth push is the one that doubles the capacity and copies the cells, and a
// list that never grew would not have tested the half of the implementation
// most likely to be wrong.

show_list() {
  int[] xs = [];
  fill(xs);
  list_line(xs);
} return void;
():() then calls fill:[1] then calls list_line:[1]
():() then eprints:("")

fill(int[] xs) {
  int i = 0;
  while(i < 6) {
    push(xs, (i + 1) * 10);
    i = i + 1;
  }
} return void;
([]):([10, 20, 30, 40, 50, 60])
([5]):([5, 10, 20, 30, 40, 50, 60])

list_line(int[] xs) {
  xs[1] = 99;
  int len_v = len(xs);
  list_tail(xs, len_v);
} return void;
([1, 2, 3, 4, 5, 6]):([1, 99, 3, 4, 5]) then prints:("list: len=6 [0]=1 [1]=99 [5]=6\nlist: pop=6 len=5\n")
([10, 20, 30, 40, 50, 60]):([10, 99, 30, 40, 50]) then prints:("list: len=6 [0]=10 [1]=99 [5]=60\nlist: pop=60 len=5\n")
