// Proof that there is a framebuffer and that it is where the adapter said.
//
// Three bands of flat colour and a white diagonal. Flat colour says the
// address and the stride are right; a diagonal says the two are right
// *together*, because a wrong stride turns a diagonal into a vertical line and
// leaves the bands looking perfect.
gfx_demo() {
  word w = fb_open(640, 480);
  gfx_demo_report(w);
  gfx_paint(w);
} return void;

gfx_paint(word w) {
  if(w > 0) {
    gfx_bands(w);
    gfx_diag(w);
    gfx_check(w);
  }
} return void;
given boot_gfx (0):() then calls gfx_bands:[0] then calls gfx_diag:[0] then calls gfx_check:[0]
given gfx_buf_setup (5):() then calls gfx_bands:(5) then calls gfx_diag:(5) then calls gfx_check:(5)

gfx_bands(word w) {
  word y = 0;
  while(y < fb_h()) {
    gfx_row(w, y);
    y = y + 1;
  }
} return void;
given boot_gfx (5):() then calls gfx_row:[0]
given gfx_buf_setup (5):() then calls gfx_row:[480]
