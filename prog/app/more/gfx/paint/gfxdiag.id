// A white diagonal from the top left. A wrong stride leaves the bands looking
// right and turns this into a vertical line, which is the whole reason it is
// here rather than a fourth band.
gfx_diag(word w) {
  word x = 0;
  while(x < w && x < fb_h()) {
    gfx_dot(x);
    x = x + 1;
  }
} return void;
given gfx_buf_setup (3):() then calls gfx_dot:(0) then calls gfx_dot:(1) then calls gfx_dot:(2)
given boot_gfx (5):() then calls gfx_dot:[0]

gfx_dot(word x) {
  fb_px(x, x, 0x00ffffff);
  fb_px(x + 1, x, 0x00ffffff);
} return void;
given boot_gfx (5):() then calls fb_px:(5, 5, 0x00ffffff) then calls fb_px:(6, 5, 0x00ffffff)
given boot_gfx (0):() then calls fb_px:(0, 0, 0x00ffffff) then calls fb_px:(1, 0, 0x00ffffff)
