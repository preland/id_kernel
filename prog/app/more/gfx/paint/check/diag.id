// The on-diagonal sample and the off-diagonal sample beside it -- the pair
// that differs only by the stride, which is the whole point of this test.
gfx_check_diag() {
  string diag_s = gfx_diag_str();
  print("fb: diag " + diag_s);
} return void;
given gfx_buf_setup ():() then prints:("fb: diag 0x0000000000000000 off 0x0000000000000000\n")
given gfx_buf_setup ():() then eprints:("")

gfx_diag_str() {
  string h4 = read_hex(100, 100);
  string h5 = read_hex(100, 300);
  string ret_s = h4 + " off " + h5;
} return string ret_s;
given gfx_buf_setup ():("0x0000000000000000 off 0x0000000000000000") then fb_w:(640)
given gfx_buf_setup ():("0x0000000000000000 off 0x0000000000000000") then fb_h:(480)

// The buffer gfx_check_diag/gfx_check_bands/fb_rd read back through: a real
// address, backed by enough allocated memory for every coordinate those
// callers use, rather than the zeroed fb_st boot_gfx alone leaves behind.
gfx_buf_setup() {
  boot_gfx();
  word a = alloc(1228800);
  fb_note(a, 640, 480);
} return void;
():() then fb_w:(640)
():() then fb_h:(480)
