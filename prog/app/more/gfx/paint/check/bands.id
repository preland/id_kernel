// The three band samples, read and joined before there is anywhere to print
// them from -- gfx_check only has room to call, not to format.
gfx_check_bands(word w) {
  string bands_s = gfx_bands_str(w);
  print("fb: bands " + bands_s);
} return void;
given gfx_buf_setup (30):() then prints:("fb: bands 0x0000000000000000 0x0000000000000000 0x0000000000000000\n")
given gfx_buf_setup (30):() then eprints:("")

gfx_bands_str(word w) {
  string pair_s = hex_pair(10, 240, w / 2, 240);
  string h3 = read_hex(w - 10, 240);
  string ret_s = pair_s + " " + h3;
} return string ret_s;
given gfx_buf_setup (30):("0x0000000000000000 0x0000000000000000 0x0000000000000000") then fb_w:(640)
given gfx_buf_setup (40):("0x0000000000000000 0x0000000000000000 0x0000000000000000") then fb_w:(640)

hex_pair(word x1, word y1, word x2, word y2) {
  string h1 = read_hex(x1, y1);
  string h2 = read_hex(x2, y2);
  string ret_s = h1 + " " + h2;
} return string ret_s;
given gfx_buf_setup (10, 240, 20, 240):("0x0000000000000000 0x0000000000000000") then fb_w:(640)
given gfx_buf_setup (0, 0, 0, 0):("0x0000000000000000 0x0000000000000000") then fb_h:(480)
