// Reading the framebuffer back, so that a test can see it over the serial port
// rather than racing the emulator's monitor for a screenshot.
//
// The picture is only correct if the base address and the stride are both
// correct, and a wrong stride leaves the bands looking perfect -- so what is
// read back is one pixel from each band, one on the diagonal, and one just
// off it. The last pair is the whole point: they differ only by the stride.
gfx_check(word w) {
  gfx_check_bands(w);
  gfx_check_diag();
} return void;
given gfx_buf_setup (30):() then prints:("fb: bands 0x0000000000000000 0x0000000000000000 0x0000000000000000\nfb: diag 0x0000000000000000 off 0x0000000000000000\n")
given gfx_buf_setup (30):() then eprints:("")

fb_rd(word x, word y) {
  word fb_base_v = fb_base();
  word fb_w_v = fb_w();
  word ret_w = peek32(fb_base_v + (y * fb_w_v + x) * 4) & 0xffffff;
} return word ret_w;
given gfx_buf_setup (0, 0):(0)
given gfx_buf_setup (100, 100):(0)

read_hex(word x, word y) {
  word fb_rd_v = fb_rd(x, y);
  string ret_s = hexw(fb_rd_v);
} return string ret_s;
given gfx_buf_setup (0, 0):("0x0000000000000000")
given gfx_buf_setup (100, 100):("0x0000000000000000") then fb_w:(640)
