// The rest of the help text, continued from `help.id`.
sh_help4() {
  con_line("touch PATH       make an empty file");
  con_line("write PATH TEXT  put TEXT in a file, making it if need be");
  sh_help5();
} return void;
given boot_gfx ():() then prints:("touch PATH       make an empty file\nwrite PATH TEXT  put TEXT in a file, making it if need be\nrm PATH          remove a file or a directory\nclear            blank the screen\nuname  mem       what this is, and how much store is used\nhalt   fault     stop the machine, or touch an unmapped page\n")
given boot_gfx ():() then calls con_line:[6]

