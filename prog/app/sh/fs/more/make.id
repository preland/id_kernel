// Making a node at a path. `mkdir` and `touch` differ only in the flag.
//
// Nothing checks whether the name is already taken: a second `mkdir foo`
// appends a second node, and the lookup finds the later one because it walks
// the whole list and keeps the last match. That is a real gap rather than a
// choice -- it wants a lookup before the push, which is one more action than
// this block has.
fs_make(string t, int dir) {
  int at = fs_par(t);
  if(at < 0) {
    con_line("no such directory: " + t);
  } else {
    string cut_v = fs_last_seg(t);
    fs_new(at, dir, cut_v, "");
  }
} return void;
given fs_init ("newdir", 1):() then calls fs_new:(0, 1, "newdir", "")
given fs_init given boot_gfx ("nosuch/x", 1):() then prints:("no such directory: nosuch/x\n")

// The same, for a file that is being written to before it exists, so that
// `write` does not need a `touch` in front of it.
fs_make2(string name, string t) {
  int at = fs_par(name);
  if(at < 0) {
    con_line("write: no such directory: " + name);
  } else {
    string cut_v = fs_last_seg(name);
    fs_new(at, 0, cut_v, t);
  }
} return void;
given fs_init ("note.txt", "hi"):() then calls fs_new:(0, 0, "note.txt", "hi")
given fs_init given boot_gfx ("nosuch/x", "hi"):() then prints:("write: no such directory: nosuch/x\n")

// Replacing a file's contents, or creating the file. There is no append and no
// editor: a `write` is the whole of a file, which is the smallest thing that
// still lets somebody at this prompt put bytes somewhere and read them back.
fs_put(string name, string t) {
  int at = fs_path(name);
  if(at < 0) {
    fs_make2(name, t);
  } else {
    sset((import fs_data), at, t);
  }
} return void;
given fs_init ("README", "new contents"):() then calls sset:[1]
given fs_init ("newfile.txt", "abc"):() then calls fs_make2:[1]
