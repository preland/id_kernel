// An empty segment resolves to where it started -- see resolve.id for why that
// is what makes a leading, trailing, or doubled slash all harmless.
fs_step_seg(int at, string name) {
  int got = at;
  if(len(name) > 0) {
    got = fs_seg(at, name);
  }
} return int got;
